    "pw.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take your time back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera tu tiempo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprenditi il tuo tempo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir deine Zeit zurück"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprends ton temps"
          }
        }
      }
    },
    "pw.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta members cut their screen time by half in the first week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros de Basta reducen su tiempo de pantalla a la mitad en la primera semana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi usa Basta dimezza il tempo di schermo nella prima settimana."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta-Nutzer halbieren ihre Bildschirmzeit in der ersten Woche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres Basta divisent leur temps d'écran par deux dès la première semaine."
          }
        }
      }
    },
