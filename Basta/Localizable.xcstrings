    "onb.hook.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enough scrolling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta de scroll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta scrollare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schluss mit Scrollen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop au scroll."
          }
        }
      }
    },
    "onb.hook.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You lose hours a day to apps you didn't even mean to open. Basta blocks them when you need focus — and gives you your time back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierdes horas al día en apps que ni querías abrir. Basta las bloquea cuando necesitas concentrarte y te devuelve tu tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdi ore al giorno in app che non volevi nemmeno aprire. Basta le blocca quando ti serve concentrazione e ti restituisce il tuo tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verlierst täglich Stunden an Apps, die du nicht mal öffnen wolltest. Basta sperrt sie, wenn du Fokus brauchst – und gibt dir deine Zeit zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perds des heures chaque jour dans des apps que tu ne voulais même pas ouvrir. Basta les bloque quand tu as besoin de te concentrer – et te rend ton temps."
          }
        }
      }
    },
    "onb.how.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo funciona"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come funziona"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert's"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment ça marche"
          }
        }
      }
    },
    "onb.how.schedule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block apps on a schedule — work, sleep, study."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea apps por horario: trabajo, sueño, estudio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca le app a orari: lavoro, sonno, studio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps nach Zeitplan sperren – Arbeit, Schlaf, Lernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque des apps selon un horaire – travail, sommeil, études."
          }
        }
      }
    },
    "onb.how.place": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block apps automatically when you arrive somewhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea apps automáticamente al llegar a un lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca le app automaticamente quando arrivi in un luogo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps automatisch sperren, wenn du irgendwo ankommst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque des apps automatiquement quand tu arrives quelque part."
          }
        }
      }
    },
    "onb.how.strict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict mode: no way out until the session ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo estricto: sin salida hasta que termine la sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità rigida: nessuna via d'uscita fino alla fine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strenger Modus: kein Ausweg, bis die Session endet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode strict : impossible d'en sortir avant la fin de la session."
          }
        }
      }
    },
    "onb.how.quick": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap for 15, 30 or 60 minutes of focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque para 15, 30 o 60 minutos de foco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco per 15, 30 o 60 minuti di concentrazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp für 15, 30 oder 60 Minuten Fokus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toucher pour 15, 30 ou 60 minutes de concentration."
          }
        }
      }
    },
    "onb.perm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Tiempo de uso"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Tempo di utilizzo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmzeit erlauben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser Temps d'écran"
          }
        }
      }
    },
    "onb.perm.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta uses Apple's Screen Time to block the apps you choose. Nothing else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta usa Tiempo de uso de Apple para bloquear las apps que elijas. Nada más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta usa Tempo di utilizzo di Apple per bloccare le app che scegli. Nient'altro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta nutzt Apples Bildschirmzeit, um die Apps zu sperren, die du wählst. Sonst nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta utilise Temps d'écran d'Apple pour bloquer les apps que tu choisis. Rien d'autre."
          }
        }
      }
    },
    "onb.perm.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on your iPhone. We never see which apps you use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en tu iPhone. Nunca vemos qué apps usas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta sul tuo iPhone. Non vediamo mai quali app usi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf deinem iPhone. Wir sehen nie, welche Apps du nutzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur ton iPhone. Nous ne voyons jamais quelles apps tu utilises."
          }
        }
      }
    },
    "onb.perm.cta": {
      "localizations": {
        "en": {
          "stringUnit": {
