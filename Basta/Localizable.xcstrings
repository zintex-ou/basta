    "pw.legal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription renews automatically unless cancelled at least 24 hours before the end of the period. Manage in App Store settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente salvo que se cancele al menos 24 horas antes del fin del periodo. Gestiónala en los ajustes del App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento si rinnova automaticamente salvo disdetta almeno 24 ore prima della fine del periodo. Gestiscilo nelle impostazioni dell'App Store."
          }
        }
      }
    },
