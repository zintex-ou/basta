    "pw.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta members cut their screen time by half in the first week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros de Basta reducen su tiempo de pantalla a la mitad en la primera semana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi usa Basta dimezza il tempo di schermo nella prima settimana."
          }
        }
      }
    },
