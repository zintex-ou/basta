    "onb.apps.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What distracts you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te distrae?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti distrae?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was lenkt dich ab?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui te distrait ?"
          }
        }
      }
    },
    "onb.apps.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the apps that eat your time. You can change this anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las apps que te roban tiempo. Puedes cambiarlo cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le app che ti rubano tempo. Puoi cambiarle quando vuoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Apps, die deine Zeit fressen. Du kannst das jederzeit ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les apps qui te volent du temps. Tu peux changer ça à tout moment."
          }
        }
      }
    },
