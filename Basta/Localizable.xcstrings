{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onb.next": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua"
          }
        }
      }
    },
    "onb.finish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia"
          }
        }
      }
    },
    "onb.hook.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enough scrolling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta de scroll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta scrollare."
          }
        }
      }
    },
    "onb.hook.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You lose hours a day to apps you didn't even mean to open. Basta blocks them when you need focus — and gives you your time back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierdes horas al día en apps que ni querías abrir. Basta las bloquea cuando necesitas concentrarte y te devuelve tu tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdi ore al giorno in app che non volevi nemmeno aprire. Basta le blocca quando ti serve concentrazione e ti restituisce il tuo tempo."
          }
        }
      }
    },
    "onb.how.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo funciona"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come funziona"
          }
        }
      }
    },
    "onb.how.schedule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block apps on a schedule — work, sleep, study."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea apps por horario: trabajo, sueño, estudio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca le app a orari: lavoro, sonno, studio."
          }
        }
      }
    },
    "onb.how.place": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block apps automatically when you arrive somewhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea apps automáticamente al llegar a un lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca le app automaticamente quando arrivi in un luogo."
          }
        }
      }
    },
    "onb.how.strict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict mode: no way out until the session ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo estricto: sin salida hasta que termine la sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità rigida: nessuna via d'uscita fino alla fine."
          }
        }
      }
    },
    "onb.how.quick": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap for 15, 30 or 60 minutes of focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque para 15, 30 o 60 minutos de foco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco per 15, 30 o 60 minuti di concentrazione."
          }
        }
      }
    },
    "onb.perm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Tiempo de uso"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Tempo di utilizzo"
          }
        }
      }
    },
    "onb.perm.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta uses Apple's Screen Time to block the apps you choose. Nothing else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta usa Tiempo de uso de Apple para bloquear las apps que elijas. Nada más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta usa Tempo di utilizzo di Apple per bloccare le app che scegli. Nient'altro."
          }
        }
      }
    },
    "onb.perm.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on your iPhone. We never see which apps you use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en tu iPhone. Nunca vemos qué apps usas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta sul tuo iPhone. Non vediamo mai quali app usi."
          }
        }
      }
    },
    "onb.perm.cta": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti"
          }
        }
      }
    },
    "onb.apps.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What distracts you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te distrae?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti distrae?"
          }
        }
      }
    },
    "onb.apps.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the apps that eat your time. You can change this anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las apps que te roban tiempo. Puedes cambiarlo cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le app che ti rubano tempo. Puoi cambiarle quando vuoi."
          }
        }
      }
    },
    "onb.apps.pick": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose apps"
          }
        },
