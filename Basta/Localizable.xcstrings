    "pw.legal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription renews automatically unless cancelled at least 24 hours before the end of the period. Manage in App Store settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente salvo que se cancele al menos 24 horas antes del fin del periodo. Gestiónala en los ajustes del App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento si rinnova automaticamente salvo disdetta almeno 24 ore prima della fine del periodo. Gestiscilo nelle impostazioni dell'App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor Ende des Zeitraums gekündigt wird. Verwaltung in den App Store-Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement se renouvelle automatiquement sauf résiliation au moins 24 heures avant la fin de la période. Gère-le dans les réglages de l'App Store."
          }
        }
      }
    },
