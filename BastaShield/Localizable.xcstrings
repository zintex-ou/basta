    "shield.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is blocked right now. You chose this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app está bloqueada ahora. Tú lo decidiste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app è bloccata adesso. L'hai deciso tu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist gerade gesperrt. Du hast es so entschieden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app est bloquée pour l'instant. C'est toi qui l'as décidé."
          }
        }
      }
    },
    "shield.subtitle.strict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict mode is on. No way out until the session ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo estricto activo. Sin salida hasta que termine la sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità rigida attiva. Nessuna via d'uscita fino alla fine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strenger Modus aktiv. Kein Ausweg, bis die Session endet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode strict actif. Impossible d'en sortir avant la fin de la session."
          }
        }
      }
    },
    "shield.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
