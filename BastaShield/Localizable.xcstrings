          }
        }
      }
    },
    "shield.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is blocked right now. You chose this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app está bloqueada ahora. Tú lo decidiste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app è bloccata adesso. L'hai deciso tu."
          }
        }
      }
    },
    "shield.subtitle.strict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict mode is on. No way out until the session ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo estricto activo. Sin salida hasta que termine la sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità rigida attiva. Nessuna via d'uscita fino alla fine."
          }
        }
      }
    },
    "shield.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ok"
          }
        }
      }
